#version 450

// ========= STRUCTS (mirroring c++ structs) =========
struct Camera {
    vec3 position;
    vec3 pixel_delta_u;
    vec3 pixel_delta_v;
    vec3 pixel_00_loc;
    vec3 ambient_color;

    uint image_width;
    uint image_height;

    uint samples_per_pixel;
};

struct Material {
    // Aligned to 16 bytes
    vec3 color;
    float refraction_index;

    // Aligned to 16 bytes
    vec3 ambient;
    float transparency;

    // Aligned to 16 bytes
    vec3 specular;
    float shininess;

    vec3 emission;
};

struct SceneObject {
    int type;
    int material_index;
    vec2 padding; // Padding for alignment

    // Sphere data
    vec3 center;
    float radius;

    // Plane data
    vec3 point_on_plane;
    vec3 normal;

    mat4 transform;
    mat4 inverse_transform; 
    mat4 inverse_transpose_transform; 
};

struct Light {
    vec3 position;
    vec3 color;
};

struct HitRecord {
    float t;
    vec3 p;
    vec3 normal;
    bool front_face;
    int material_index;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

void set_face_normal(inout HitRecord rec, in Ray r, in vec3 outward_normal) {
    rec.front_face = dot(r.direction, outward_normal) < 0.0;
    rec.normal = rec.front_face ? outward_normal : -outward_normal;
}

struct trace_log {
    // Cor local (ambiente + difusa + especular das luzes + emissão)
    vec3 local_color; 
    
    // 0 = Caminho termina aqui (difuso ou miss)
    // 1 = Refrata e Reflete (transparente)
    // 2 = Apenas Reflete (espelho)
    uint path;

    // Dados do raio para o próximo passo
    Ray reflection_ray;
    Ray refraction_ray;

    // Dados da colisão para obter material, normal, etc.
    bool hit;
    HitRecord rec;
};

// ========= BUFFERS (Bindings) =========
layout(set = 0, binding = 0) buffer OutputBuffer { vec4 imageData[]; } outBuffer;
layout(set = 0, binding = 1) uniform UBO { Camera camera; } ubo;
layout(set = 0, binding = 2) readonly buffer ObjectBuffer { SceneObject objects[]; } objectBuffer;
layout(set = 0, binding = 3) readonly buffer MaterialBuffer { Material materials[]; } materialBuffer;
layout(set = 0, binding = 4) readonly buffer LightBuffer { Light lights[]; } lightBuffer;

// =========

Ray transform_ray(Ray ray, mat4 transform) {
    vec4 transformed_origin = transform * vec4(ray.origin, 1.0);
    vec4 transformed_direction = transform * vec4(ray.direction, 0.0);
    return Ray(transformed_origin.xyz, normalize(transformed_direction).xyz);
}

float schlick(float cosine, float refraction_index) {
    float r0 = (1.0 - refraction_index) / (1.0 + refraction_index);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

// ========= INTERSECTION FUNCTIONS =========

bool hit_sphere(in int object_index, in Ray ray, in float t_min, in float t_max, inout HitRecord rec) {
    SceneObject s = objectBuffer.objects[object_index];
    Ray transformed_ray = transform_ray(ray, s.inverse_transform);

    vec3 oc = transformed_ray.origin - s.center;
    float a = dot(transformed_ray.direction, transformed_ray.direction);
    float half_b = dot(oc, transformed_ray.direction);
    float c = dot(oc, oc) - s.radius * s.radius;
    float discriminant = half_b * half_b - a * c;

    if (discriminant < 0.0) {
        return false;
    }

    float sqrt_discriminant = sqrt(discriminant);

    float root = (-half_b - sqrt_discriminant) / a;

    vec3 local_hit_point = transformed_ray.origin + root * transformed_ray.direction;
    vec3 world_hit_point = vec3(s.transform * vec4(local_hit_point, 1.0));
    float t_world = dot(world_hit_point - ray.origin, ray.direction);

    if (t_world < t_min || t_world > t_max) {
        root = (-half_b + sqrt_discriminant) / a;
        local_hit_point = transformed_ray.origin + root * transformed_ray.direction;
        world_hit_point = vec3(s.transform * vec4(local_hit_point, 1.0));
        t_world = dot(world_hit_point - ray.origin, ray.direction);

        if (t_world < t_min || t_world > t_max) {
            return false;
        }
    }
    
    rec.t = t_world;
    rec.p = world_hit_point;
    
    vec3 outward_normal_local = (local_hit_point - s.center) / s.radius;
    vec3 outward_normal_world = normalize(vec3(s.inverse_transpose_transform * vec4(outward_normal_local, 0.0)));
    
    set_face_normal(rec, ray, outward_normal_world);
    rec.material_index = s.material_index;

    return true;
}

bool hit_plane(in int object_index, in Ray ray, in float t_min, in float t_max, inout HitRecord rec) {
    SceneObject s = objectBuffer.objects[object_index];
    Ray transformed_ray = transform_ray(ray, s.inverse_transform);

    float denom = dot(transformed_ray.direction, s.normal);
    if (abs(denom) < 1e-6) {
        return false; // Ray is parallel to the plane
    }
    float t_local = dot(s.point_on_plane - transformed_ray.origin, s.normal) / denom;

    if (t_local < 0.0) {
        return false;
    }

    vec3 local_hit_point = transformed_ray.origin + t_local * transformed_ray.direction;
    vec3 world_hit_point = vec3(s.transform * vec4(local_hit_point, 1.0));
    float t_world = dot(world_hit_point - ray.origin, ray.direction);

    if (t_world < t_min || t_world > t_max) {
        return false;
    }

    rec.t = t_world;
    rec.p = world_hit_point;
    
    vec3 outward_normal_world = normalize(vec3(s.inverse_transpose_transform * vec4(s.normal, 0.0)));
    set_face_normal(rec, ray, outward_normal_world);
    rec.material_index = s.material_index;

    return true;
}

// ========= RAY TRACING FUNCTION =========

bool hit_closest(Ray ray, inout HitRecord rec) {
    bool hit = false;
    float closest_t = 1.0 / 0.0; // Initialize to infinity

    for (int i = 0; i < objectBuffer.objects.length(); i++) {
        HitRecord temp_rec;
        SceneObject obj = objectBuffer.objects[i];
        if (obj.type == 0) { // Sphere
            if (hit_sphere(i, ray, 1e-4, closest_t, temp_rec)) {
                hit = true;
                closest_t = temp_rec.t;
                rec = temp_rec;
            }
        }
        
        else if (obj.type == 1) { // Plane
            if (hit_plane(i, ray, 1e-4, closest_t, temp_rec)) {
                hit = true;
                closest_t = temp_rec.t;
                rec = temp_rec;
            }
        }
    }

    return hit;
}

bool is_in_shadow(int light_index, inout HitRecord rec) {
    Light light = lightBuffer.lights[light_index];
    float light_distance = length(light.position - rec.p);
    vec3 light_direction = normalize(light.position - rec.p);

    Ray shadow_ray = Ray(rec.p + rec.normal * 1e-4, light_direction);
    HitRecord shadow_rec;
    for (int i = 0; i < objectBuffer.objects.length(); i++) {
        SceneObject obj = objectBuffer.objects[i];
        if (obj.type == 0) { // Sphere
            if (hit_sphere(i, shadow_ray, 1e-4, light_distance, shadow_rec)) {
                return true; // In shadow
            }
        }
        
        else if (obj.type == 1) { // Plane
            if (hit_plane(i, shadow_ray, 1e-4, light_distance, shadow_rec)) {
                return true; // In shadow
            }
        }
    }

    return false; // Not in shadow
}

trace_log trace(Ray ray) {
    trace_log t_log;
    t_log.hit = hit_closest(ray, t_log.rec);

    if (!t_log.hit) {
        t_log.local_color = ubo.camera.ambient_color; // Cor de fundo
        t_log.path = 0; // O caminho termina
        return t_log;
    }

    Material mat = materialBuffer.materials[t_log.rec.material_index];
    vec3 surface_color = mat.ambient * ubo.camera.ambient_color;
    vec3 view_direction = normalize(ray.origin - t_log.rec.p);

    // Calcula iluminação direta (Difusa e Especular)
    for (int i = 0; i < lightBuffer.lights.length(); i++) {
        if (!is_in_shadow(i, t_log.rec)) {
            Light light = lightBuffer.lights[i];
            vec3 light_direction = normalize(light.position - t_log.rec.p);
            
            // Componente Difusa
            float diffuse_intensity = max(dot(t_log.rec.normal, light_direction), 0.0);
            surface_color += mat.color * diffuse_intensity * light.color;

            // Componente Especular (Blinn-Phong)
            if (mat.shininess > 0.0) {
                 vec3 reflection_direction = reflect(-light_direction, t_log.rec.normal);
                 float specular_intensity = pow(max(dot(view_direction, reflection_direction), 0.0), mat.shininess);
                 surface_color += mat.specular * specular_intensity * light.color;
            }
        }
    }

    t_log.local_color = mat.emission + surface_color;
    t_log.path = 0; // Por padrão, o caminho termina aqui

    // Se o material for transparente/refrativo
    if (mat.transparency < 1.0) {
        t_log.path = 1; // Sinaliza para refratar e refletir
        vec3 reflection_direction = reflect(ray.direction, t_log.rec.normal);
        t_log.reflection_ray = Ray(t_log.rec.p + t_log.rec.normal * 1e-4, reflection_direction);

        float refraction_ratio = t_log.rec.front_face ? (1.0 / mat.refraction_index) : mat.refraction_index;
        float cos_theta = min(dot(-ray.direction, t_log.rec.normal), 1.0);
        float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

        // Se não houver reflexão interna total, prepare o raio de refração
        if (refraction_ratio * sin_theta <= 1.0) {
            vec3 refraction_direction = refract(ray.direction, t_log.rec.normal, refraction_ratio);
            t_log.refraction_ray = Ray(t_log.rec.p - t_log.rec.normal * 1e-4, refraction_direction);
        }
    }
    // Se o material for refletivo (mas não transparente)
    else if (mat.specular != vec3(0.0)) {
        t_log.path = 2; // Sinaliza para refletir
        vec3 reflection_direction = reflect(ray.direction, t_log.rec.normal);
        t_log.reflection_ray = Ray(t_log.rec.p + t_log.rec.normal * 1e-4, reflection_direction);
    }

    return t_log;
}

struct RayState {
    Ray ray;
    vec3 contribution; // Contribuição acumulada de cor para este caminho
    uint depth;
};

vec3 render(Ray initial_ray, uint max_depth) {
    vec3 final_color = vec3(0.0);

    const int STACK_SIZE = 128;
    RayState stack[STACK_SIZE];
    int stack_ptr = 0;

    // 1. Empilhar o raio inicial
    if (stack_ptr < STACK_SIZE) {
        stack[stack_ptr].ray = initial_ray;
        // 'contribution' agora funciona como 'throughput' ou 'peso do caminho'.
        // Ele carrega o fator de mistura acumulado (ex: ks, 1-opacity, etc.)
        stack[stack_ptr].contribution = vec3(1.0);
        stack[stack_ptr].depth = 0;
        stack_ptr++;
    }

    // 2. Loop principal
    while (stack_ptr > 0) {
        stack_ptr--;
        RayState current_state = stack[stack_ptr];

        if (current_state.depth >= max_depth) {
            continue;
        }

        trace_log t_log = trace(current_state.ray);

        // Se o raio não atingiu nada, adicionamos a cor de fundo (ambiente)
        // ponderada pela contribuição do caminho e terminamos este caminho.
        if (!t_log.hit) {
            final_color += current_state.contribution * ubo.camera.ambient_color;
            continue;
        }

        // Se atingiu um objeto, começamos a aplicar a lógica de mistura.
        Material mat = materialBuffer.materials[t_log.rec.material_index];
        
        // Separe a cor local em emissão e iluminação de superfície (difusa/especular/ambiente)
        // t_log.local_color já contém a soma de tudo (exceto emissão, que é adicionada depois).
        // Para simplificar, vamos chamar tudo de surface_illumination.
        vec3 surface_illumination = t_log.local_color - mat.emission;


        // 1. Adiciona a componente emissiva. A luz emitida não é afetada por blending.
        final_color += current_state.contribution * mat.emission;

        // 2. Lógica de mistura baseada no tipo de material.
        
        // CASO 1: TRANSPARENTE (Refrata e Reflete)
        // Corresponde a `if (opacity < 1.0)` no C++
        if (t_log.path == 1) {
            // Fator de opacidade. No C++, `d`. Aqui, `transparency` é o valor de 0 a 1.
            // Assumindo que `mat.transparency` é a opacidade (d).
            float opacity = mat.transparency;

            // Adiciona a contribuição da iluminação local, ATENUADA pela opacidade.
            final_color += current_state.contribution * surface_illumination * opacity;

            // Calcula o fator de reflexão de Fresnel (quanto reflete vs. refrata)
            float cos_theta = min(dot(-current_state.ray.direction, t_log.rec.normal), 1.0);
            float refraction_ratio = t_log.rec.front_face ? (1.0 / mat.refraction_index) : mat.refraction_index;
            float reflectance = schlick(cos_theta, refraction_ratio);

            // A contribuição restante (1.0 - opacity) será dividida entre reflexão e refração.
            vec3 path_contribution = current_state.contribution * (1.0 - opacity);

            // Empilhar raio de reflexão
            if (reflectance > 0.0 && stack_ptr < STACK_SIZE) {
                stack[stack_ptr].ray = t_log.reflection_ray;
                // A contribuição é a do caminho * fator de reflexão * cor especular
                stack[stack_ptr].contribution = path_contribution * reflectance * mat.specular;
                stack[stack_ptr].depth = current_state.depth + 1;
                stack_ptr++;
            }

            // Empilhar raio de refração
            if (reflectance < 1.0 && stack_ptr < STACK_SIZE) {
                 stack[stack_ptr].ray = t_log.refraction_ray;
                 // A contribuição é a do caminho * fator de refração * cor do objeto
                 stack[stack_ptr].contribution = path_contribution * (1.0 - reflectance) * mat.color;
                 stack[stack_ptr].depth = current_state.depth + 1;
                 stack_ptr++;
            }
        }
        // CASO 2: REFLETIVO OPACO (Espelho)
        // Corresponde a `else if (mat->ks.r > 0 ...)` no C++
        else if (t_log.path == 2) {
            // Fator de mistura é a cor especular (`ks` no C++)
            vec3 specular_color = mat.specular;

            // Adiciona a iluminação local, ATENUADA pelo inverso da cor especular.
            final_color += current_state.contribution * surface_illumination * (vec3(1.0) - specular_color);
            
            // Empilha o raio de reflexão com a contribuição da cor especular.
            if (stack_ptr < STACK_SIZE) {
                stack[stack_ptr].ray = t_log.reflection_ray;
                stack[stack_ptr].contribution = current_state.contribution * specular_color;
                stack[stack_ptr].depth = current_state.depth + 1;
                stack_ptr++;
            }
        }
        // CASO 0: DIFUSO OPACO (Caminho termina aqui)
        else {
            // Adiciona toda a iluminação local, pois não há raios secundários para misturar.
            final_color += current_state.contribution * surface_illumination;
        }
    }

    return clamp(final_color, 0.0, 1.0);
}

// ========= PSEUDO-RANDOM NUMBER GENERATION =========

vec2 rand2(vec2 p) {
    return fract(
        sin(
            vec2(
                dot(p, vec2(12.9898, 78.233)),
                dot(p, vec2(39.346, 49.125))
            )
        ) * 43758.5453
    );
}

float radical_inverse_base2(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

// Gera o n-ésimo ponto da sequência de Hammersley bidimensional
vec2 hammersley(uint i, uint N) {
    // A primeira dimensão usa a fração i/N
    // A segunda dimensão usa a inversão de radicais de 'i' na base 2
    return vec2(float(i) / float(N), radical_inverse_base2(i));
}

// Uma função de hash de alta qualidade que combina múltiplas entradas.
// Ela recebe as coordenadas do pixel e o índice da amostra para gerar um "ruído" único.
uint hash(uvec2 pixel_coords, uint sample_index) {
    // Começa combinando as coordenadas do pixel
    uint seed = pixel_coords.x + pixel_coords.y * 1920u; // Use a largura da sua imagem aqui se quiser

    // Mistura o índice da amostra para garantir que cada amostra seja diferente
    seed = seed ^ (sample_index * 747796405u + 1013904223u);
    
    // Embaralha os bits (algoritmo de hash comum)
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

// Retorna um vec2 com números pseudo-aleatórios no intervalo [0, 1)
vec2 rand2f(uvec2 pixel_coords, uint sample_index) {
    // Gera o primeiro número aleatório
    uint n1 = hash(pixel_coords, sample_index);
    
    // Para o segundo número, podemos simplesmente usar o primeiro como semente para o próximo,
    // ou perturbar a semente original de forma simples.
    // Usar uma semente levemente diferente (sample_index + 1) é uma boa prática.
    uint n2 = hash(pixel_coords, sample_index + 1u);
    
    // Normaliza os resultados para o intervalo [0, 1)
    return vec2(float(n1) / float(0xFFFFFFFFu), float(n2) / float(0xFFFFFFFFu));
}

// ========= MAIN PROGRAM =========
layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

void main() {
    const uint ANTI_ALIASING_SAMPLES = ubo.camera.samples_per_pixel;
    const uint MAX_DEPTH = 4;

    uvec2 pixelCoords = gl_GlobalInvocationID.xy;
    if (pixelCoords.x >= ubo.camera.image_width || pixelCoords.y >= ubo.camera.image_height) {
        return;
    }
    uint index = pixelCoords.y * ubo.camera.image_width + pixelCoords.x;

    vec3 pixel_color = vec3(0.0);
    for (int i = 0; i < ANTI_ALIASING_SAMPLES; ++i) {
        // vec2 random_offset = hammersley(uint(i), uint(ANTI_ALIASING_SAMPLES)) - 0.5;
        vec2 random_offset = rand2f(pixelCoords, uint(i)) - 0.5;

        vec3 pixel_center = ubo.camera.pixel_00_loc + 
                            (ubo.camera.pixel_delta_u * pixelCoords.x) - 
                            (ubo.camera.pixel_delta_v * pixelCoords.y);

        vec3 sample_target = pixel_center + 
                            (ubo.camera.pixel_delta_u * random_offset.x) -
                            (ubo.camera.pixel_delta_v * random_offset.y);

        vec3 ray_origin = ubo.camera.position;
        vec3 ray_direction = normalize(sample_target - ray_origin);
        Ray sample_ray = Ray(ray_origin, ray_direction);

        pixel_color += render(sample_ray, MAX_DEPTH);
    }
    
    pixel_color /= float(ANTI_ALIASING_SAMPLES);

    outBuffer.imageData[index] = vec4(pixel_color, 1.0);
}